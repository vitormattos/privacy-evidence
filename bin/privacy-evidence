#!/usr/bin/env php
<?php

declare(strict_types=1);

use PrivacyEvidence\Command\AnalyzeCommand;
use PrivacyEvidence\Command\DatasetPrepareClaudinhaCommand;
use PrivacyEvidence\Command\DoctorCommand;
use PrivacyEvidence\Command\HacktoberfestDemoBuildCommand;
use PrivacyEvidence\Command\HacktoberfestDemoCommand;
use PrivacyEvidence\Command\MlBenchmarkCommand;
use PrivacyEvidence\Command\MlInferSignalCommand;
use PrivacyEvidence\Command\MlTrainSignalCommand;
use PrivacyEvidence\Command\ReportCommand;
use PrivacyEvidence\Command\ReviewAgreementCommand;
use PrivacyEvidence\Command\ReviewExportCommand;
use PrivacyEvidence\Command\ReviewHtmlCommand;
use PrivacyEvidence\Command\ReviewImportCommand;
use PrivacyEvidence\Command\ReviewSampleCommand;
use PrivacyEvidence\Command\ReviewEvaluateCommand;
use PrivacyEvidence\Command\ResumeCommand;
use PrivacyEvidence\Command\RunCommand;
use PrivacyEvidence\Command\SourceImportCommand;
use PrivacyEvidence\Command\SourceSampleWebsitesCommand;
use PrivacyEvidence\Command\SourceSelectCommand;
use PrivacyEvidence\Command\SourceStatsCommand;
use PrivacyEvidence\Command\StatusCommand;
use PrivacyEvidence\Command\WorkerCommand;
use PrivacyEvidence\Command\WorkerPoolCommand;
use Symfony\Component\Console\Application;

$projectRoot = dirname(__DIR__);
require $projectRoot . '/vendor/autoload.php';

$application = new Application('Privacy Evidence', '0.1.0-dev');
$application->addCommand(new DoctorCommand($projectRoot));
$application->addCommand(new HacktoberfestDemoBuildCommand());
$application->addCommand(new HacktoberfestDemoCommand());
$application->addCommand(new DatasetPrepareClaudinhaCommand());
$application->addCommand(new MlTrainSignalCommand());
$application->addCommand(new MlBenchmarkCommand());
$application->addCommand(new MlInferSignalCommand());
$application->addCommand(new SourceImportCommand());
$application->addCommand(new SourceSampleWebsitesCommand());
$application->addCommand(new SourceSelectCommand());
$application->addCommand(new SourceStatsCommand());
$application->addCommand(new RunCommand($projectRoot));
$application->addCommand(new ResumeCommand($projectRoot));
$application->addCommand(new StatusCommand($projectRoot));
$application->addCommand(new WorkerCommand($projectRoot));
$application->addCommand(new WorkerPoolCommand($projectRoot));
$application->addCommand(new AnalyzeCommand($projectRoot));
$application->addCommand(new ReportCommand($projectRoot));
$application->addCommand(new ReviewAgreementCommand($projectRoot));
$application->addCommand(new ReviewExportCommand($projectRoot));
$application->addCommand(new ReviewHtmlCommand($projectRoot));
$application->addCommand(new ReviewImportCommand($projectRoot));
$application->addCommand(new ReviewSampleCommand($projectRoot));
$application->addCommand(new ReviewEvaluateCommand($projectRoot));
$application->run();
