{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vitormattos/privacy-evidence/schema/imported-resource.schema.json",
  "title": "ImportedResource",
  "type": "object",
  "required": [
    "id",
    "name",
    "sourceValue",
    "normalizedUrl",
    "type",
    "classification",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "sourceValue": {
      "type": "string"
    },
    "normalizedUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "type": {
      "enum": [
        "institutional_website",
        "social_network",
        "video_platform",
        "link_aggregator",
        "third_party_hosted_page",
        "malformed",
        "unknown"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null"
        ]
      }
    },
    "classification": {
      "type": "object",
      "required": [
        "rule",
        "version",
        "confidence"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
