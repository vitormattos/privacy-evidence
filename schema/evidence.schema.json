{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vitormattos/privacy-evidence/schema/evidence.schema.json",
  "title": "PrivacyEvidence",
  "type": "object",
  "required": [
    "type",
    "state",
    "resourceId",
    "artifactHash",
    "sourceUrl",
    "detector",
    "detectorVersion",
    "method",
    "confidence",
    "needsReview",
    "attributes"
  ],
  "properties": {
    "type": {"type": "string"},
    "state": {
      "enum": [
        "present",
        "absent",
        "unknown",
        "unavailable",
        "invalid",
        "excluded",
        "not_applicable"
      ]
    },
    "resourceId": {"type": "string"},
    "artifactHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourceUrl": {"type": "string", "format": "uri"},
    "detector": {"type": "string"},
    "detectorVersion": {"type": "string"},
    "method": {"type": "string"},
    "excerpt": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "needsReview": {"type": "boolean"},
    "attributes": {"type": "object"}
  },
  "additionalProperties": false
}
