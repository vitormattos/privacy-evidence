{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vitormattos/privacy-evidence/schema/annotation-package.schema.json",
  "title": "Privacy Evidence annotation package",
  "type": "object",
  "additionalProperties": false,
  "required": ["packageVersion", "annotationHandbookVersion", "runId", "seed", "perStratum", "cases"],
  "allOf": [{"if": {"properties": {"packageVersion": {"const": "1.1.0"}}}, "then": {"required": ["reviewDocuments"], "properties": {"cases": {"items": {"required": ["reviewContext"]}}}}}],
  "properties": {
    "testMode": {"type": "boolean", "description": "True marks form QA answers, which human import rejects."},
    "packageVersion": {"enum": ["1.0.0", "1.1.0"]},
    "annotationHandbookVersion": {"const": "1.0.0"},
    "runId": {"type": "string", "minLength": 1},
    "seed": {"type": "string", "minLength": 1},
    "perStratum": {"type": "integer", "minimum": 1},
    "reviewDocuments": {"type": "object", "propertyNames": {"pattern": "^[a-f0-9]{64}$"}, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["title", "text"], "properties": {"title": {"type": "string"}, "text": {"type": "string"}}}},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidenceId", "resourceId", "evidenceType", "automatedState", "sourceUrl",
          "artifactHash", "detector", "detectorVersion", "confidence", "needsReview",
          "humanState", "rationale", "reviewedAt"
        ],
        "properties": {
          "evidenceId": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "resourceId": {"type": "string", "minLength": 1},
          "evidenceType": {"type": "string", "minLength": 1},
          "automatedState": {
            "enum": ["present", "absent", "unknown", "unavailable", "invalid", "excluded", "not_applicable"]
          },
          "sourceUrl": {"type": "string", "minLength": 1},
          "artifactHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "reviewContext": {"type": "object", "additionalProperties": false, "required": ["resourceName", "resourceUrl", "fetchedAt", "truncated", "reason"], "properties": {"resourceName": {"type": ["string", "null"]}, "resourceUrl": {"type": ["string", "null"]}, "fetchedAt": {"type": ["string", "null"]}, "reason": {"type": ["string", "null"]}, "truncated": {"type": "boolean"}}},
          "excerpt": {"type": ["string", "null"]},
          "detector": {"type": "string", "minLength": 1},
          "detectorVersion": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "needsReview": {"type": "boolean"},
          "humanState": {
            "type": ["string", "null"],
            "enum": [null, "present", "absent", "unknown", "unavailable", "invalid", "excluded", "not_applicable"]
          },
          "rationale": {"type": ["string", "null"]},
          "reviewedAt": {
            "anyOf": [
              {"type": "null"},
              {"type": "string", "format": "date-time"}
            ]
          }
        }
      }
    }
  }
}

